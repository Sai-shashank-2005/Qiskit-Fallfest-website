---
import { highlights } from '../../data/highlights';
---

<section class="py-24 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        HIGHLIGHTS
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">What to Expect?</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {highlights.map((item) => (
        <div class="relative p-8 rounded-3xl bg-surface/40 backdrop-blur-md border border-white/5 flex flex-col items-center text-center overflow-hidden group shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 hover:border-white/10 hover:bg-surface/60">
          
          <!-- Subtle Glow behind icon -->
          <div class="absolute top-10 w-24 h-24 bg-[#ff4d80]/0 rounded-full blur-2xl group-hover:bg-[#ff4d80]/10 transition-colors duration-700 pointer-events-none"></div>
          
          <div class="relative w-16 h-16 mb-6 text-text-muted group-hover:text-[#ff4d80] group-hover:scale-110 transition-all duration-500 flex items-center justify-center bg-bg/50 border border-border group-hover:border-[#ff4d80]/20 rounded-2xl shadow-inner z-10" set:html={item.icon}>
          </div>
          <h3 class="text-base font-medium leading-relaxed px-2 text-text transition-colors duration-300 relative z-10">{item.title}</h3>
        </div>
      ))}
    </div>
  </div>
</section>
