---
// SponsorSection component
---
<style>
  @keyframes slideShine {
    0% { transform: translateX(-150%) skewX(-20deg); }
    100% { transform: translateX(250%) skewX(-20deg); }
  }
  .group:hover .shine-effect {
    animation: slideShine 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
</style>

<section class="py-32 relative overflow-hidden bg-transparent">
  <div class="container mx-auto px-6 max-w-5xl relative z-10">
    
    <!-- Section Title -->
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        PARTNERS
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">In Collaboration With</h2>
    </div>

    <!-- Partner Cards -->
    <div class="grid md:grid-cols-2 gap-8 items-center justify-center">
      
      <!-- Technology Partner: IBM Quantum -->
      <div class="group relative bg-surface/40 backdrop-blur-md border border-white/5 p-10 rounded-3xl transition-all duration-500 overflow-hidden flex flex-col items-center justify-center h-64 sm:h-72 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-white/10 hover:bg-surface/60">
        <!-- Animated Shine -->
        <div class="shine-effect absolute inset-0 w-2/3 h-full bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-[150%] skew-x-[-20deg] pointer-events-none z-0"></div>
        
        <span class="absolute top-6 left-8 text-[9px] uppercase tracking-[0.2em] text-[#ff4d80] font-bold opacity-80 group-hover:opacity-100 transition-opacity">Technology Partner</span>
        
        <div class="relative z-10 flex flex-col items-center justify-center h-full w-full">
          <img 
            src="/brand/ibm-quantum/ibm.png" 
            alt="IBM Quantum" 
            class="h-14 sm:h-16 w-auto object-contain grayscale-[0.3] group-hover:grayscale-0 group-hover:scale-110 transition-all duration-700 ease-out"
          />
        </div>
      </div>
      
      <!-- Platform Partner: Qryptex -->
      <a href="https://qryptex.in" target="_blank" rel="noopener noreferrer" class="group relative bg-surface/40 backdrop-blur-md border border-white/5 p-10 rounded-3xl transition-all duration-500 overflow-hidden flex flex-col items-center justify-center h-64 sm:h-72 cursor-pointer shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-white/10 hover:bg-surface/60">
        <!-- Animated Shine -->
        <div class="shine-effect absolute inset-0 w-2/3 h-full bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-[150%] skew-x-[-20deg] pointer-events-none z-0"></div>

        <span class="absolute top-6 left-8 text-[9px] uppercase tracking-[0.2em] text-[#b45bfa] font-bold opacity-80 group-hover:opacity-100 transition-opacity">Platform Partner</span>
        
        <div class="relative z-10 flex flex-col items-center justify-center h-full w-full gap-4">
          <img src="/brand/qryptex/qryptex.jpeg" alt="Qryptex Logo" class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl object-cover border border-white/10 shadow-md group-hover:shadow-[0_0_20px_rgba(180,91,250,0.3)] group-hover:-translate-y-1 group-hover:scale-105 transition-all duration-500" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <div class="flex flex-col items-center justify-center text-center">
            <div class="text-xl sm:text-2xl tracking-[0.25em] font-light text-text group-hover:text-white transition-colors duration-500">QRYPTEX</div>
            <div class="text-[8px] sm:text-[9px] uppercase tracking-[0.2em] text-text-muted font-bold mt-1.5 group-hover:text-[#b45bfa] transition-colors duration-500 flex items-center justify-center gap-1.5">
              Powered By Qryptex
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
            </div>
          </div>
        </div>
      </a>

    </div>

  </div>
</section>
