---
// Hero component
---

<section class="relative min-h-screen flex items-center justify-center pt-24 overflow-hidden">
  
  <!-- Background Quantum Visuals (Static fallback/structure) -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-50">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-quantum/20 rounded-full animate-spin-slow"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-quantum/30 rounded-full animate-spin-slow" style="animation-direction: reverse; animation-duration: 18s;"></div>
    <!-- Radial gradient for depth -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-quantum/5 via-transparent to-transparent"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 grid lg:grid-cols-2 gap-12 items-center">
    
    <!-- Text Content -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-full border border-border bg-surface/50 backdrop-blur text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        Official Event Designation
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6 tracking-tight">
        A decade of <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-quantum">quantum</span> on the cloud.
      </h1>
      
      <p class="text-xl text-text-muted mb-8 leading-relaxed max-w-lg">
        Qiskit Fall Fest 2026. Join us at Bharathidasan University for a premium technical conference exploring the future of quantum computing.
      </p>
      
      <div class="flex flex-wrap items-center gap-4">
        <a href="/register" class="px-8 py-4 bg-primary text-bg font-semibold rounded hover:opacity-90 transition-all shadow-[0_0_20px_rgba(var(--color-primary),0.3)]">
          Register Now
        </a>
        <a href="#events" class="px-8 py-4 border border-border bg-surface/50 backdrop-blur rounded hover:bg-surface transition-all font-medium">
          Explore Event
        </a>
      </div>
    </div>
    
    <!-- Visual / Badge -->
    <div class="relative flex justify-center items-center">
      <div class="relative w-full max-w-md aspect-square flex items-center justify-center">
        <!-- Event Badge Image -->
        <img 
          src="/brand/qiskit/qiskit-badge.png" 
          alt="Qiskit Fall Fest Badge" 
          class="w-64 h-64 object-contain drop-shadow-2xl z-10"
          onerror="this.src='/brand/qiskit/Fall Fest Sticker Small.png'"
        />
      </div>
    </div>
    
  </div>
</section>
