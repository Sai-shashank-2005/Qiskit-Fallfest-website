---
// WhyFallFest component
---

<section id="about" class="py-24 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        ABOUT
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Why Fall Fest?</h2>
      <p class="text-text-muted max-w-2xl text-lg font-light">Join the global quantum community to learn, build, and collaborate.</p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6 relative z-10" id="cards-container">
      
      <!-- Learn Card -->
      <div class="glow-card group relative p-10 rounded-[2rem] bg-surface/40 backdrop-blur-md border border-white/5 overflow-hidden min-h-[380px] flex flex-col justify-between hover:border-white/10 hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#ff4d80]/10 transition-all duration-500">
        <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0" style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(255, 77, 128, 0.05), transparent 40%);"></div>
        
        <div class="relative z-10">
          <div class="w-14 h-14 mb-8 rounded-2xl bg-bg/50 border border-border group-hover:border-[#ff4d80]/30 flex items-center justify-center text-text-muted group-hover:scale-110 group-hover:text-[#ff4d80] transition-all duration-500 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3 class="text-3xl font-bold mb-4 text-text group-hover:text-[#ff4d80] transition-colors duration-300">Learn.</h3>
          <p class="text-text-muted text-sm leading-relaxed font-light transition-colors">
            From the basics of quantum mechanics to real-world algorithms and applications.
          </p>
        </div>
        
        <!-- Animated visual (Restored) -->
        <div class="absolute -bottom-10 -left-10 w-56 h-56 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#b45bfa]/10 via-transparent to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none">
          <div class="absolute bottom-1/4 left-1/4 w-32 h-32 border border-[#b45bfa]/20 rounded-full animate-[spin_10s_linear_infinite] group-hover:border-[#b45bfa]/40 transition-colors">
            <div class="absolute -top-1 left-1/2 w-2 h-2 bg-[#b45bfa] rounded-full shadow-[0_0_8px_#b45bfa]"></div>
          </div>
          <div class="absolute bottom-1/3 left-1/3 w-16 h-16 border border-[#ff4d80]/20 rounded-full animate-[spin_6s_linear_infinite_reverse] group-hover:border-[#ff4d80]/40 transition-colors"></div>
        </div>
      </div>

      <!-- Build Card -->
      <div class="glow-card group relative p-10 rounded-[2rem] bg-surface/40 backdrop-blur-md border border-white/5 overflow-hidden min-h-[380px] flex flex-col justify-between hover:border-white/10 hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#b45bfa]/10 transition-all duration-500">
        <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0" style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(180, 91, 250, 0.05), transparent 40%);"></div>

        <div class="relative z-10">
          <div class="w-14 h-14 mb-8 rounded-2xl bg-bg/50 border border-border group-hover:border-[#b45bfa]/30 flex items-center justify-center text-text-muted group-hover:scale-110 group-hover:text-[#b45bfa] transition-all duration-500 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="text-3xl font-bold mb-4 text-text group-hover:text-[#b45bfa] transition-colors duration-300">Build.</h3>
          <p class="text-text-muted text-sm leading-relaxed font-light transition-colors">
            Hands-on workshops and sessions using Qiskit on IBM Quantum hardware.
          </p>
        </div>
        
        <!-- Animated visual (Restored) -->
        <div class="absolute -bottom-6 right-0 w-64 h-64 flex items-end justify-end p-4 opacity-60 group-hover:opacity-100 transition-all duration-700 group-hover:scale-105 pointer-events-none">
          <div class="w-24 h-24 bg-gradient-to-br from-[#b45bfa]/20 to-[#b45bfa]/5 rounded-lg border border-white/5 backdrop-blur-sm shadow-[0_0_20px_rgba(180,91,250,0.15)] transform rotate-12 group-hover:rotate-6 transition-transform duration-500 animate-[pulse_4s_ease-in-out_infinite]"></div>
          <div class="w-16 h-16 bg-gradient-to-br from-[#ff4d80]/20 to-[#ff4d80]/5 rounded-lg border border-white/5 backdrop-blur-sm absolute bottom-12 right-20 shadow-[0_0_20px_rgba(255,77,128,0.15)] transform -rotate-12 group-hover:-rotate-6 transition-transform duration-500 animate-[pulse_3s_ease-in-out_infinite]" style="animation-delay: 1s;"></div>
        </div>
      </div>

      <!-- Collaborate Card -->
      <div class="glow-card group relative p-10 rounded-[2rem] bg-surface/40 backdrop-blur-md border border-white/5 overflow-hidden min-h-[380px] flex flex-col justify-between hover:border-white/10 hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#0077b5]/10 transition-all duration-500">
        <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0" style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(0, 119, 181, 0.05), transparent 40%);"></div>
        
        <div class="relative z-10">
          <div class="w-14 h-14 mb-8 rounded-2xl bg-bg/50 border border-border group-hover:border-[#0077b5]/30 flex items-center justify-center text-text-muted group-hover:scale-110 group-hover:text-[#0077b5] transition-all duration-500 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="text-3xl font-bold mb-4 text-text group-hover:text-[#0077b5] transition-colors duration-300">Collaborate.</h3>
          <p class="text-text-muted text-sm leading-relaxed font-light transition-colors">
            Connect, compete and create the future with the global quantum community.
          </p>
        </div>
        
        <!-- Animated visual (Restored) -->
        <div class="absolute bottom-0 right-0 w-full h-2/3 bg-gradient-to-t from-[#0077b5]/5 to-transparent flex items-end justify-center p-4 overflow-hidden pointer-events-none">
           <div class="w-[150%] border-t border-[#0077b5]/20 absolute bottom-16 rotate-[-15deg] group-hover:rotate-[-10deg] transition-transform duration-700"></div>
           <div class="w-[150%] border-t border-white/10 absolute bottom-16 rotate-[15deg] group-hover:rotate-[10deg] transition-transform duration-700"></div>
           
           <div class="w-3 h-3 rounded-full bg-[#0077b5] absolute bottom-14 right-16 shadow-[0_0_15px_#0077b5] group-hover:scale-150 transition-transform duration-500"></div>
           <div class="w-2 h-2 rounded-full bg-white absolute bottom-20 left-1/4 shadow-[0_0_10px_white] group-hover:scale-150 transition-transform duration-500"></div>
           <div class="w-1.5 h-1.5 rounded-full bg-white absolute bottom-10 left-1/2 shadow-[0_0_5px_white] animate-pulse"></div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('cards-container');
    if (container && window.innerWidth > 768) {
      const cards = container.querySelectorAll('.glow-card');
      
      container.addEventListener('mousemove', (e) => {
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }
  });
</script>
