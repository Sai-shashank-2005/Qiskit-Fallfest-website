---
// Footer component
---

<footer class="bg-surface border-t border-border py-12">
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12 items-start">
      
      <div class="md:col-span-2 flex flex-col items-center md:items-start text-center md:text-left gap-6">
        <div class="flex items-center justify-center md:justify-start gap-6">
          <img src="/brand/qiskit/qiskit-badge.png" alt="Qiskit Badge" class="w-16 h-16 md:w-20 md:h-20 object-contain" onerror="this.style.display='none'" />
          <div class="h-10 md:h-12 w-px bg-border"></div>
          <img src="/brand/bdu/bdu.png" alt="Bharathidasan University Logo" class="h-12 md:h-16 w-auto object-contain" onerror="this.style.display='none'" />
        </div>
        <div class="flex flex-col items-center md:items-start">
          <h3 class="font-bold text-text mb-2">Qiskit Fall Fest 2026</h3>
          <a href="https://www.google.com/maps/search/Bharathidasan+University" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted mb-1 font-light hover:text-[#ff4d80] transition-colors hover:underline underline-offset-2 flex items-center justify-center md:justify-start gap-1 w-max mx-auto md:mx-0">
            Bharathidasan University, India
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
          </a>
          <p class="text-sm text-text-muted mb-6 font-light">Oct 24 – Oct 25, 2026</p>
          
          <div class="flex items-center justify-center md:justify-start gap-4 text-text-muted">
