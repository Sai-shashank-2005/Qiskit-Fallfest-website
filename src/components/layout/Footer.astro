---
// Footer component
---

<footer class="bg-surface/40 pt-20 pb-8 relative overflow-hidden backdrop-blur-xl border-t border-white/5">
  <!-- Glowing top border -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#b45bfa]/40 to-transparent"></div>
  
  <!-- Ambient Glow -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute -bottom-[30%] left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#ff4d80]/10 via-[#b45bfa]/5 to-transparent blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-6 max-w-7xl relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8 mb-16 items-start">
      
      <div class="md:col-span-5 lg:col-span-6 flex flex-col items-center md:items-start text-center md:text-left gap-8">
        <!-- Partner Logos -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-5 md:gap-8 bg-surface/50 p-4 rounded-2xl border border-white/5 backdrop-blur-sm">
          <img src="/brand/qiskit/qiskit-badge.png" alt="Qiskit Badge" class="h-12 md:h-16 w-auto object-contain hover:scale-105 transition-transform" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <div class="h-8 md:h-10 w-px bg-border/50"></div>
          <img src="/brand/bdu/bdu.png" alt="Bharathidasan University Logo" class="h-10 md:h-12 w-auto object-contain hover:scale-105 transition-transform" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <div class="h-8 md:h-10 w-px bg-border/50"></div>
          <div class="flex flex-col items-center justify-center gap-1 group">
             <span class="text-[8px] uppercase tracking-widest text-text-muted font-bold">Powered By</span>
             <img src="/brand/qryptex/qryptex.jpeg" alt="Qryptex Logo" class="h-10 md:h-12 w-10 md:w-12 rounded-full object-cover border border-white/10 group-hover:border-[#ff4d80]/50 transition-colors shadow-lg" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          </div>
        </div>
        
        <div class="flex flex-col items-center md:items-start">
          <h3 class="text-xl md:text-2xl font-bold text-text mb-2 tracking-wide">Qiskit Fall Fest 2026</h3>
          <div class="flex flex-col items-center md:items-start space-y-2 mt-2">
            <a href="https://www.google.com/maps/search/Bharathidasan+University" target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted font-light hover:text-[#ff4d80] transition-colors hover:underline underline-offset-4 inline-flex items-center gap-2 group">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#ff4d80] group-hover:scale-110 transition-transform"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Bharathidasan University, India
            </a>
            <p class="text-sm text-text-muted font-light inline-flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#b45bfa]"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              Mid October, 2026
            </p>
          </div>
        </div>
      </div>
      
      <div class="md:col-span-3 lg:col-span-3 flex flex-col items-center md:items-start">
        <h4 class="text-text font-semibold mb-6 uppercase tracking-widest text-xs">Navigation</h4>
        <ul class="space-y-4 text-sm text-text-muted font-light text-center md:text-left">
          <li><a href="#schedule" class="hover:text-[#ff4d80] transition-colors">Schedule</a></li>
          <li><a href="#speakers" class="hover:text-[#ff4d80] transition-colors">Speakers</a></li>
          <li><a href="#about" class="hover:text-[#ff4d80] transition-colors">About Us</a></li>
          <li><a href="#faq" class="hover:text-[#ff4d80] transition-colors">FAQ</a></li>
        </ul>
      </div>
      
      <div class="md:col-span-4 lg:col-span-3 flex flex-col items-center md:items-start">
        <h4 class="text-text font-semibold mb-6 uppercase tracking-widest text-xs">Connect</h4>
        <div class="flex items-center gap-4 text-text-muted mb-8">
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-white/5 flex items-center justify-center hover:bg-[#ff4d80]/10 hover:text-[#ff4d80] hover:border-[#ff4d80]/30 transition-all shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg></a>
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-white/5 flex items-center justify-center hover:bg-[#b45bfa]/10 hover:text-[#b45bfa] hover:border-[#b45bfa]/30 transition-all shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg></a>
          <a href="#" class="w-10 h-10 rounded-full bg-surface border border-white/5 flex items-center justify-center hover:bg-[#ff4d80]/10 hover:text-[#ff4d80] hover:border-[#ff4d80]/30 transition-all shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
        </div>
      </div>
    </div>
    
    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-text-muted font-light tracking-widest uppercase">
      <div>&copy; 2026 Qiskit Fall Fest. All rights reserved.</div>
      <div class="flex items-center gap-6">
         <a href="#" class="hover:text-text transition-colors">Privacy Policy</a>
         <a href="#" class="hover:text-text transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
