---
import { organizers } from '../../data/organizers';
---

<section id="organizers" class="py-24 relative overflow-hidden bg-surface/30">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        TEAM
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Meet the Organizers</h2>
      <p class="text-text-muted max-w-2xl text-lg font-light">The dedicated individuals bringing the Fall Fest to life.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {organizers.map((organizer, i) => (
        <div class="flex flex-col p-6 bg-surface border border-border/50 rounded-2xl gap-4 group hover:-translate-y-1 hover:shadow-xl hover:shadow-[#b45bfa]/10 hover:border-[#b45bfa]/30 transition-all duration-500 relative overflow-hidden" style={`animation-delay: ${i * 0.1}s;`}>
          
          <!-- Gradient Hover Strip -->
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[#ff4d80] to-[#b45bfa] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          
          <div class="flex items-center gap-5">
            <!-- Vibrant Icon Container -->
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#b45bfa]/10 to-transparent border border-[#b45bfa]/20 group-hover:border-[#b45bfa]/40 transition-colors flex items-center justify-center shrink-0 overflow-hidden relative shadow-sm text-[#b45bfa]">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform duration-300">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            
            <div class="flex-grow flex flex-col justify-center">
              <h3 class="font-bold text-lg text-text mb-1 group-hover:text-[#b45bfa] transition-colors">{organizer.name}</h3>
              <div class="inline-block px-2 py-0.5 bg-border/40 text-text-muted rounded text-[10px] font-bold uppercase tracking-widest w-fit">
                {organizer.role}
              </div>
            </div>
            
            <div class="flex flex-col items-center gap-3 shrink-0 opacity-80 group-hover:opacity-100 transition-opacity pl-2 border-l border-border/50">
              <a href={organizer.linkedin || "#"} target={organizer.linkedin && organizer.linkedin !== "#" ? "_blank" : "_self"} rel="noopener noreferrer" class="text-text-muted hover:text-[#0077b5] hover:scale-110 transition-all" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href={organizer.github || "#"} target={organizer.github && organizer.github !== "#" ? "_blank" : "_self"} rel="noopener noreferrer" class="text-text-muted hover:text-text hover:scale-110 transition-all" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
