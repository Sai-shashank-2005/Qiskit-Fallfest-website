---
import { highlights } from '../../data/highlights';
---

<section class="py-24 relative overflow-hidden bg-surface/30 border-y border-border/50">
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="mb-12 flex items-center justify-center gap-4">
      <div class="h-px bg-border flex-grow max-w-[40px]"></div>
      <h2 class="text-2xl font-semibold tracking-tight">What to Expect?</h2>
      <div class="h-px bg-border flex-grow max-w-[40px]"></div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      {highlights.map((item) => (
        <div class="p-8 rounded-2xl bg-surface border border-border flex flex-col items-center text-center hover:border-[#ff4d80]/50 hover:-translate-y-2 hover:shadow-xl hover:shadow-[#ff4d80]/10 transition-all duration-300 group">
          <div class="w-16 h-16 mb-6 text-[#ff4d80] opacity-80 group-hover:opacity-100 group-hover:scale-110 group-hover:text-[#b45bfa] transition-all flex items-center justify-center bg-bg rounded-full shadow-sm" set:html={item.icon}>
          </div>
          <h3 class="text-sm font-semibold leading-relaxed px-2 text-text">{item.title}</h3>
        </div>
      ))}
    </div>
  </div>
</section>
