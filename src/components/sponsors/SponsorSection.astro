---
// SponsorSection component
---

<section class="py-32 relative overflow-hidden bg-transparent">
  <div class="container mx-auto px-6 max-w-5xl relative z-10">
    
    <!-- Section Title -->
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        PARTNERS
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">In Collaboration With</h2>
    </div>

    <!-- Partner Cards -->
    <div class="grid md:grid-cols-2 gap-8 items-center justify-center">
      
      <!-- Technology Partner: IBM Quantum -->
      <div class="group relative bg-surface border border-border/50 p-8 rounded-3xl transition-all duration-500 overflow-hidden flex flex-col items-center justify-center h-48 sm:h-56 shadow-sm hover:shadow-lg hover:border-border hover:-translate-y-1">
        
        <span class="absolute top-6 left-8 text-[9px] uppercase tracking-[0.2em] text-text-muted font-bold transition-opacity z-10">Technology Partner</span>
        
        <div class="relative z-10 flex flex-col items-center justify-center h-full w-full px-4 mt-4">
          <img 
            src="/event/materials/ibm.png" 
            alt="IBM Quantum" 
            class="h-16 sm:h-20 md:h-24 w-auto object-contain dark:invert transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            loading="lazy" decoding="async"
          />
        </div>
      </div>
      
      <!-- Platform Partner: Qryptex -->
      <a href="https://qryptex.in" target="_blank" rel="noopener noreferrer" class="group relative bg-surface border border-border/50 p-8 rounded-3xl transition-all duration-500 overflow-hidden flex flex-col items-center justify-center h-48 sm:h-56 cursor-pointer shadow-sm hover:shadow-lg hover:border-border hover:-translate-y-1">

        <span class="absolute top-6 left-8 text-[9px] uppercase tracking-[0.2em] text-text-muted font-bold transition-opacity z-10">Platform Partner</span>
        
        <div class="relative z-10 flex items-center justify-center h-full w-full gap-5 mt-4">
          <img src="/brand/qryptex/qryptex.jpeg" alt="Qryptex Logo" class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover border border-border shadow-sm group-hover:shadow-md transition-all duration-500 group-hover:scale-[1.02]" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <div class="flex flex-col items-start justify-center">
            <div class="text-2xl sm:text-3xl tracking-[0.2em] font-light text-text transition-colors duration-500 leading-none">QRYPTEX</div>
            <div class="text-[9px] uppercase tracking-[0.15em] text-text-muted font-bold mt-2 transition-colors duration-500 flex items-center gap-1.5">
              Powered By Qryptex
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
            </div>
          </div>
        </div>
      </a>

    </div>

  </div>
</section>
