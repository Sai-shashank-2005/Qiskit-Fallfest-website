---
import { highlights } from '../../data/highlights';
---

<section class="py-24 relative overflow-hidden bg-bg">
  
  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-bold text-text-muted shadow-sm">
        HIGHLIGHTS
      </div>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">What to Expect?</h2>
      <p class="text-text-muted max-w-2xl text-lg font-light">Immerse yourself in a full week of quantum exploration, challenges, and incredible networking.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="highlights-container">
      {highlights.map((item, index) => {
        const colors = [
          { light: 'rgba(255, 77, 128, 0.08)', hoverBg: 'group-hover:bg-[#ff4d80]/10', hoverBorder: 'group-hover:border-[#ff4d80]/40', hoverText: 'group-hover:text-[#ff4d80]' },
          { light: 'rgba(180, 91, 250, 0.08)', hoverBg: 'group-hover:bg-[#b45bfa]/10', hoverBorder: 'group-hover:border-[#b45bfa]/40', hoverText: 'group-hover:text-[#b45bfa]' },
          { light: 'rgba(0, 119, 181, 0.08)', hoverBg: 'group-hover:bg-[#0077b5]/10', hoverBorder: 'group-hover:border-[#0077b5]/40', hoverText: 'group-hover:text-[#0077b5]' },
        ];
        const color = colors[index % 3];
        
        return (
          <div class="glow-card group relative p-8 rounded-[2rem] bg-surface/40 backdrop-blur-md border border-white/5 flex flex-col items-center text-center overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 hover:-translate-y-1 hover:border-white/10 hover:bg-surface/60" data-color={color.light}>
            
            <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0"></div>
            
            <div class={`absolute top-10 w-24 h-24 rounded-full blur-2xl transition-colors duration-700 pointer-events-none bg-transparent ${color.hoverBg}`}></div>
            
            <div class={`relative w-16 h-16 mb-6 text-text-muted transition-all duration-500 flex items-center justify-center bg-bg/50 border border-border rounded-2xl shadow-inner z-10 group-hover:scale-110 ${color.hoverText} ${color.hoverBorder}`} set:html={item.icon}>
            </div>
            
            <h3 class={`text-lg font-bold leading-relaxed px-2 text-text transition-colors duration-300 relative z-10 ${color.hoverText}`}>{item.title}</h3>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('highlights-container');
    if (container && window.innerWidth > 768) {
      const cards = container.querySelectorAll('.glow-card');
      
      container.addEventListener('mousemove', (e) => {
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const color = card.getAttribute('data-color');
          const overlay = card.querySelector('.glow-overlay');
          if(overlay) {
            overlay.style.background = `radial-gradient(500px circle at ${x}px ${y}px, ${color}, transparent 40%)`;
          }
        });
      });
    }
  });
</script>
