---
import { faqs } from '../../data/faqs';
---

<section id="faq" class="py-24 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-3xl">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        FAQ
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-surface border border-border rounded-xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-6 font-medium text-text">
            {faq.question}
            <span class="shrink-0 rounded-full bg-border p-1.5 text-text-muted group-open:bg-[#b45bfa]/10 group-open:text-[#b45bfa] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-300 group-open:-rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </span>
          </summary>
          <div class="faq-content overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out">
            <div class="px-6 pb-6 text-text-muted leading-relaxed">
              {faq.answer}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const detailsElements = document.querySelectorAll('details');
    detailsElements.forEach((details) => {
      const summary = details.querySelector('summary');
      const content = details.querySelector('.faq-content');
      
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        
        const isOpen = details.hasAttribute('open');
        
        if (isOpen) {
          content.style.maxHeight = '0px';
          content.style.opacity = '0';
          setTimeout(() => {
            details.removeAttribute('open');
          }, 300);
        } else {
          details.setAttribute('open', '');
          // Small delay to allow browser to render block before calculating scrollHeight
          requestAnimationFrame(() => {
            content.style.maxHeight = content.scrollHeight + 'px';
            content.style.opacity = '1';
          });
        }
      });
    });
  });
</script>
