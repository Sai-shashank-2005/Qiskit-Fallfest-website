---
import { speakers } from '../../data/speakers';
import { organizers } from '../../data/organizers';
---

<section id="people" class="py-24 relative overflow-hidden">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="grid lg:grid-cols-3 gap-12 lg:gap-16">
      
      <!-- Speakers (Spans 2 columns on large) -->
      <div class="lg:col-span-2">
        <div class="mb-8 flex items-center justify-between">
          <div class="flex items-center gap-4 flex-grow">
            <h2 class="text-2xl font-semibold tracking-tight">Featured Speakers</h2>
            <div class="h-px bg-border flex-grow max-w-[40px]"></div>
          </div>
          <!-- Not active in design, but visually present -->
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {speakers.map((speaker) => (
            <div class="bg-surface border border-border rounded-xl overflow-hidden hover:border-[#ff4d80]/50 transition-colors shadow-sm group">
              <!-- Placeholder for avatar image -->
              <div class="aspect-square bg-border/30 relative">
                <div class="absolute inset-0 flex items-end justify-center pb-4 text-xs text-text-muted">Photo</div>
                <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-50"></div>
              </div>
              <div class="p-5">
                <h3 class="font-bold text-sm mb-1">{speaker.name}</h3>
                <p class="text-xs text-text-muted mb-0.5">{speaker.organization}</p>
                <p class="text-xs text-text-muted mb-4">{speaker.role}</p>
                <a href="#" class="inline-block text-text-muted hover:text-[#0077b5] transition-colors" aria-label="LinkedIn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Organizers (Spans 1 column on large) -->
      <div>
        <div class="mb-8 flex items-center justify-between">
          <h2 class="text-2xl font-semibold tracking-tight">Organizers</h2>
          <a href="#" class="text-sm text-[#ff4d80] font-medium hover:opacity-80 transition-opacity flex items-center gap-1">View all &rarr;</a>
        </div>

        <div class="flex flex-col gap-6">
          {organizers.map((organizer) => (
            <div class="flex items-center gap-4 group cursor-pointer">
              <div class="w-14 h-14 rounded-full bg-border/30 border border-border group-hover:border-[#ff4d80]/50 transition-colors flex items-center justify-center shrink-0 overflow-hidden text-[10px] text-text-muted">
                Img
              </div>
              <div>
                <h3 class="font-bold text-sm">{organizer.name}</h3>
                <p class="text-xs text-text-muted mb-1">{organizer.role}</p>
                <a href="#" class="text-text-muted hover:text-[#0077b5] transition-colors inline-block" aria-label="LinkedIn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
