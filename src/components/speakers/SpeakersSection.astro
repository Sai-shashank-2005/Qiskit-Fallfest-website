---
import { speakers } from '../../data/speakers';
---

<section id="speakers" class="py-24 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        EXPERTS
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Meet the Speakers</h2>
    </div>

    <div class="flex flex-col items-center gap-8">
      {speakers.map((speaker, i) => (
        <div class="w-full max-w-4xl bg-surface border border-border rounded-3xl flex flex-col md:flex-row items-center md:items-stretch gap-2 md:gap-10 hover:border-[#ff4d80]/50 transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-[#ff4d80]/10 group p-8 md:p-10 animate-fade-in-up" style={`animation-delay: ${i * 0.1}s;`}>
          
          <!-- Profile Image -->
          <div class="w-48 h-48 md:w-64 md:h-auto md:aspect-square rounded-full md:rounded-2xl overflow-hidden shrink-0 border border-border/50 bg-bg relative">
            <div class="absolute inset-0 flex items-center justify-center text-sm text-text-muted">
              {speaker.image && speaker.image.includes('placeholder') ? (
                <span>Photo</span>
              ) : (
                <img src={speaker.image} alt={speaker.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" onerror="this.style.display='none';" />
              )}
            </div>
          </div>
          
          <!-- Content -->
          <div class="flex-1 flex flex-col justify-center text-center md:text-left pt-6 md:pt-0">
            <h3 class="font-bold text-2xl md:text-3xl mb-1 text-text">{speaker.name}</h3>
            <p class="text-[#ff4d80] font-mono tracking-wide text-sm mb-4">{speaker.role}</p>
            
            {speaker.bio && (
              <p class="text-sm md:text-base text-text-muted mb-8 font-light leading-relaxed max-w-2xl mx-auto md:mx-0">
                {speaker.bio}
              </p>
            )}
            
            <div class="mt-auto flex justify-center md:justify-start">
              <a href={speaker.linkedin || "#"} target={speaker.linkedin ? "_blank" : "_self"} rel={speaker.linkedin ? "noopener noreferrer" : ""} class="inline-flex items-center gap-2 text-text hover:text-[#0077b5] transition-colors font-semibold text-sm bg-border/20 hover:bg-[#0077b5]/10 px-5 py-2.5 rounded-full" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                Connect on LinkedIn
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>
