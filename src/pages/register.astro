              <option value="student">Student</option>
              <option value="researcher">Researcher</option>
              <option value="faculty">Faculty</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <button type="button" class="w-full py-4 bg-primary text-bg font-bold rounded-lg hover:opacity-90 transition-opacity mt-4">
            Submit Registration
          </button>
        </form>
        -->
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
