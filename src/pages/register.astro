---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="Register | Qiskit Fall Fest 2026">
  <Navbar />
  <main id="main-content" class="flex-grow pt-32 pb-24 bg-bg min-h-screen">
    <div class="container mx-auto px-6 max-w-lg">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-bold mb-4 tracking-tight">Register</h1>
        <p class="text-text-muted">Secure your spot at Qiskit Fall Fest 2026.</p>
      </div>
      
      <div class="bg-surface border border-border p-8 rounded-2xl shadow-xl">
        <div class="text-center py-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-primary opacity-80"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          <h2 class="text-2xl font-bold mb-2">Registration Opens Oct 1st</h2>
          <p class="text-text-muted">Please check back on October 1st to secure your spot at Qiskit Fall Fest 2026.</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
