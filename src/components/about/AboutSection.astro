---
// AboutSection component
---

<section class="py-32 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-5xl relative z-10">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      
      <!-- Text Content -->
      <div class="space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-full border border-white/10 bg-surface/50 backdrop-blur-sm text-[10px] uppercase tracking-[0.2em] font-semibold text-text-muted">
            The Experience
          </div>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-br from-white to-white/60 mb-6">
            About the Event
          </h2>
        </div>
        
        <div class="space-y-6 text-text-muted leading-relaxed font-light text-lg">
          <p>
            <span class="text-white font-medium">Qiskit Fall Fest</span> is a collection of quantum computing events on college campuses around the world.
          </p>
          <p>
            At Bharathidasan University, we are uniting students, researchers, and developers to learn the fundamentals of quantum computation and experiment directly with IBM Quantum hardware via the cloud.
          </p>
          <p class="text-[#ff4d80]/80 italic">
            Whether you are a physics major or a computer science student, the quantum future needs builders from every discipline.
          </p>
        </div>
      </div>
      
      <!-- Stats / Cards -->
      <div class="grid grid-cols-1 gap-6 relative">
        <div class="group relative bg-surface/40 backdrop-blur-xl border border-white/10 p-8 rounded-3xl hover:bg-surface/60 transition-all duration-500 overflow-hidden shadow-lg">
          <div class="absolute inset-0 bg-gradient-to-r from-[#ff4d80]/0 to-[#ff4d80]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 flex items-center justify-between">
            <div>
              <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d80] to-[#b45bfa] mb-2 group-hover:scale-105 origin-left transition-transform duration-500">2</div>
              <p class="text-sm font-medium text-text uppercase tracking-wider">Action-Packed Days</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-[#ff4d80]/10 flex items-center justify-center border border-[#ff4d80]/20 group-hover:rotate-12 transition-transform duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff4d80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </div>
          </div>
          <p class="text-text-muted text-sm mt-4 font-light">Immersive deep learning, workshops, and intensive hackathon challenges.</p>
        </div>
        
        <div class="group relative bg-surface/40 backdrop-blur-xl border border-white/10 p-8 rounded-3xl hover:bg-surface/60 transition-all duration-500 overflow-hidden shadow-lg md:translate-x-6">
          <div class="absolute inset-0 bg-gradient-to-r from-[#b45bfa]/0 to-[#b45bfa]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 flex items-center justify-between">
            <div>
              <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#b45bfa] to-[#ff4d80] mb-2 group-hover:scale-105 origin-left transition-transform duration-500">100+</div>
              <p class="text-sm font-medium text-text uppercase tracking-wider">Expected Participants</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-[#b45bfa]/10 flex items-center justify-center border border-[#b45bfa]/20 group-hover:-rotate-12 transition-transform duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b45bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
          </div>
          <p class="text-text-muted text-sm mt-4 font-light">Join brilliant minds across disciplines to build the quantum future.</p>
        </div>

      </div>
    </div>
  </div>
</section>
