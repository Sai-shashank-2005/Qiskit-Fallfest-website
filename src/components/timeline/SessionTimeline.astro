---
import { sessions } from '../../data/sessions';

const day1Sessions = sessions.filter(s => s.day === 1);
const day2Sessions = sessions.filter(s => s.day === 2);
---

<section id="schedule" class="py-32 relative overflow-hidden bg-bg">
  
  <div class="container mx-auto px-6 max-w-7xl relative z-10">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        Schedule
      </div>
      <h2 class="text-4xl lg:text-5xl font-bold tracking-tight text-text mb-6">Two-Day Experience</h2>
      <p class="text-text-muted max-w-2xl font-light text-lg">A journey from quantum fundamentals to innovation.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 lg:gap-12 relative">
      


      <!-- Day 1 List -->
      <div class="relative z-10">
        <div class="sticky top-20 z-20 bg-bg/90 backdrop-blur-xl pt-4 pb-6 mb-6 flex items-center justify-between border-b border-border/50">
          <h3 class="text-[#ff4d80] text-2xl font-bold tracking-wide flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff4d80] shadow-[0_0_10px_#ff4d80] animate-pulse"></span>
            DAY 1 <span class="hidden sm:inline font-light opacity-60">— DISCOVER</span>
          </h3>
          <span class="text-xs font-semibold px-4 py-1.5 border border-[#ff4d80]/20 rounded-full bg-[#ff4d80]/5 text-text">Mid October, 2026</span>
        </div>
        
        <div class="relative space-y-4">
          <!-- The continuous spine line perfectly centered with the dots -->
          <div class="absolute left-[11px] top-8 bottom-8 w-px bg-gradient-to-b from-transparent via-border to-transparent"></div>
          
          {day1Sessions.map((session, i) => (
            <div class="relative timeline-item flex items-stretch gap-4 sm:gap-6 opacity-0 translate-y-4 transition-all duration-700 ease-out group" style={`transition-delay: ${i * 50}ms`}>
              
              <!-- Timeline Dot Container -->
              <div class="relative z-10 flex flex-col items-center mt-6">
                <div class="w-6 h-6 rounded-full bg-surface border border-[#ff4d80]/30 flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(255,77,128,0.1)] group-hover:border-[#ff4d80]/80 group-hover:shadow-[0_0_20px_rgba(255,77,128,0.3)] transition-all duration-300">
                  <div class="w-2 h-2 rounded-full bg-[#ff4d80] group-hover:scale-150 transition-transform duration-300"></div>
                </div>
              </div>
              
              <!-- Content Card -->
              <div class="flex-1 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 p-5 rounded-2xl bg-surface/30 backdrop-blur-md border border-white/5 hover:border-[#ff4d80]/30 hover:bg-surface/60 transition-all duration-300 shadow-sm hover:shadow-lg">
                <div class="text-[11px] sm:text-xs font-mono tracking-widest text-[#ff4d80] px-3 py-1.5 bg-[#ff4d80]/10 rounded-md border border-[#ff4d80]/20 w-fit sm:w-32 text-center shrink-0 font-semibold">
                  {session.start} – {session.end}
                </div>
                <div class="text-text font-medium text-base leading-snug">
                  {session.title}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Day 2 List -->
      <div class="relative z-10">
        <div class="sticky top-20 z-20 bg-bg/90 backdrop-blur-xl pt-4 pb-6 mb-6 flex items-center justify-between border-b border-border/50">
          <h3 class="text-[#b45bfa] text-2xl font-bold tracking-wide flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#b45bfa] shadow-[0_0_10px_#b45bfa] animate-pulse"></span>
            DAY 2 <span class="hidden sm:inline font-light opacity-60">— INNOVATE</span>
          </h3>
          <span class="text-xs font-semibold px-4 py-1.5 border border-[#b45bfa]/20 rounded-full bg-[#b45bfa]/5 text-text">Mid October, 2026</span>
        </div>
        
        <div class="relative space-y-4">
          <!-- The continuous spine line perfectly centered with the dots -->
          <div class="absolute left-[11px] top-8 bottom-8 w-px bg-gradient-to-b from-transparent via-border to-transparent"></div>
          
          {day2Sessions.map((session, i) => (
            <div class="relative timeline-item flex items-stretch gap-4 sm:gap-6 opacity-0 translate-y-4 transition-all duration-700 ease-out group" style={`transition-delay: ${i * 50}ms`}>
              
              <!-- Timeline Dot Container -->
              <div class="relative z-10 flex flex-col items-center mt-6">
                <div class="w-6 h-6 rounded-full bg-surface border border-[#b45bfa]/30 flex items-center justify-center shrink-0 shadow-[0_0_15px_rgba(180,91,250,0.1)] group-hover:border-[#b45bfa]/80 group-hover:shadow-[0_0_20px_rgba(180,91,250,0.3)] transition-all duration-300">
                  <div class="w-2 h-2 rounded-full bg-[#b45bfa] group-hover:scale-150 transition-transform duration-300"></div>
                </div>
              </div>
              
              <!-- Content Card -->
              <div class="flex-1 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 p-5 rounded-2xl bg-surface/30 backdrop-blur-md border border-white/5 hover:border-[#b45bfa]/30 hover:bg-surface/60 transition-all duration-300 shadow-sm hover:shadow-lg">
                <div class="text-[11px] sm:text-xs font-mono tracking-widest text-[#b45bfa] px-3 py-1.5 bg-[#b45bfa]/10 rounded-md border border-[#b45bfa]/20 w-fit sm:w-32 text-center shrink-0 font-semibold">
                  {session.start} – {session.end}
                </div>
                <div class="text-text font-medium text-base leading-snug">
                  {session.title}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-4');
          entry.target.classList.add('opacity-100', 'translate-y-0');
        }
      });
    }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

    document.querySelectorAll('.timeline-item').forEach((el) => {
      observer.observe(el);
    });
  });
</script>
