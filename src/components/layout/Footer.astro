---
// Footer component
---

<footer class="bg-bg py-12 border-t border-border mt-16">
  <div class="container mx-auto px-6 max-w-6xl">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-10">
      
      <!-- Brand & Logos -->
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-4 bg-surface/30 px-5 py-2.5 rounded-xl border border-border/50 shadow-sm">
          <img src="/event/materials/badge-pink.svg" alt="Qiskit Badge" class="h-8 w-auto object-contain hover:scale-105 transition-transform" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <div class="h-6 w-px bg-border"></div>
          <img src="/brand/bdu/bdu.png" alt="Bharathidasan University Logo" class="h-6 w-auto object-contain hover:scale-105 transition-transform dark:brightness-150" loading="lazy" decoding="async" onerror="this.style.display='none'" />
        </div>
        
        <div class="hidden sm:flex flex-col items-start gap-0.5 group">
           <span class="text-[8px] uppercase tracking-[0.25em] text-text-muted font-bold">Powered By</span>
           <div class="flex items-center gap-2 text-text font-semibold text-sm">
             <img src="/brand/qryptex/qryptex.jpeg" alt="Qryptex Logo" class="h-5 w-5 rounded-full object-cover border border-border" loading="lazy" decoding="async" onerror="this.style.display='none'" />
             Qryptex
           </div>
        </div>
      </div>
      
      <!-- Navigation (Minimal Row) -->
      <div class="flex flex-wrap items-center justify-center gap-8 text-xs uppercase tracking-widest text-text-muted font-medium">
        <a href="/#about" class="hover:text-primary transition-colors">About</a>
        <a href="/#schedule" class="hover:text-primary transition-colors">Schedule</a>
        <a href="/#speakers" class="hover:text-primary transition-colors">Speakers</a>
        <a href="/#faq" class="hover:text-primary transition-colors">FAQ</a>
      </div>
    </div>
    
    <div class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 text-[9px] text-text-muted font-light tracking-widest uppercase">
      <div>&copy; 2026 Qiskit Fall Fest. All rights reserved.</div>
      <div class="flex items-center gap-6">
         <a href="https://www.google.com/maps/search/Bharathidasan+University" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#ff4d80]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> Bharathidasan University</a>
         <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
         <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
