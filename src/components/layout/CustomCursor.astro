---
// Custom Cursor Component
---

<div id="custom-cursor" class="hidden md:flex pointer-events-none fixed top-0 left-0 z-[9999] w-3 h-3 bg-[#ff4d80] rounded-full shadow-[0_0_15px_#ff4d80] transform -translate-x-1/2 -translate-y-1/2 transition-[width,height,background-color,border-color,border-width] duration-200 ease-out">
</div>

<style>
  /* Hide the default cursor completely */
  * {
    cursor: none !important;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Only run on devices that support hover
    if (window.matchMedia("(hover: none)").matches) return;
    
    const cursor = document.getElementById('custom-cursor');

    // Instantly track the mouse without requestAnimationFrame delay
    document.addEventListener('mousemove', (e) => {
      // Use standard translate for zero-lag hardware acceleration
      cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
    });
    
    // Setup hover states for interactive elements
    const setupInteractivity = () => {
      const clickables = document.querySelectorAll('a, button, input, textarea, select, details, [role="button"], summary');
      
      clickables.forEach((el) => {
        if (el.dataset.cursorBound) return;
        el.dataset.cursorBound = "true";

        el.addEventListener('mouseenter', () => {
          // Morph into a "pointer" style: a larger transparent ring
          cursor.classList.add('w-12', 'h-12', 'bg-transparent', 'border-2', 'border-[#b45bfa]');
          cursor.classList.remove('w-3', 'h-3', 'bg-[#ff4d80]', 'shadow-[0_0_15px_#ff4d80]');
        });
        
        el.addEventListener('mouseleave', () => {
          // Revert to default small dot
          cursor.classList.remove('w-12', 'h-12', 'bg-transparent', 'border-2', 'border-[#b45bfa]');
          cursor.classList.add('w-3', 'h-3', 'bg-[#ff4d80]', 'shadow-[0_0_15px_#ff4d80]');
        });
      });
    };

    setupInteractivity();
    
    // Re-bind dynamically if elements are added
    const observer = new MutationObserver(() => setupInteractivity());
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>
