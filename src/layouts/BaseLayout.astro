---
import '../styles/global.css';
import ScrollToTop from '../components/ui/ScrollToTop.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Qiskit Fall Fest 2026 | Bharathidasan University", 
  description = "A decade of quantum on the cloud. Join us at Bharathidasan University for Qiskit Fall Fest 2026."
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Qiskit Fall Fest 2026",
  "description": description,
  "startDate": "2026-10-01T09:00:00+05:30",
  "endDate": "2026-10-02T18:00:00+05:30",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Bharathidasan University",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tiruchirappalli",
      "addressRegion": "Tamil Nadu",
      "addressCountry": "IN"
    }
  },
  "image": [
    new URL('/event/materials/badge-pink.svg', Astro.url).toString()
  ],
  "organizer": {
    "@type": "Organization",
    "name": "Qiskit Fall Fest Organizers"
  },
  "sponsor": {
    "@type": "Organization",
    "name": "Qryptex"
  }
};
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/event/materials/badge-pink.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    
    <link rel="preload" as="image" href="/event/materials/badge-pink.svg" />
    <link rel="preload" as="image" href="/event/materials/ibm.png" />

    <meta name="description" content={description} />
    <meta name="keywords" content="Quantum Computing, Qiskit, Fall Fest 2026, Bharathidasan University, IBM Quantum, Interactive Challenges, Event" />
    <meta name="author" content="Qiskit Fall Fest Organizers" />
    <meta name="theme-color" content="#b45bfa" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={Astro.url} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/event/materials/Qiskit_Fall_Fest_2026_Black.png', Astro.url)} />
    <meta property="og:site_name" content="Qiskit Fall Fest 2026" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/event/materials/Qiskit_Fall_Fest_2026_Black.png', Astro.url)} />

    <!-- Additional SEO & Mobile -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <div id="scroll-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-[#ff4d80] to-[#b45bfa] z-[100] transition-all duration-150 ease-out w-0"></div>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-md focus:outline-none focus:ring-4 focus:ring-primary/50 transition-all font-semibold">
      Skip to main content
    </a>
    <div id="top"></div>
    <slot />
    <ScrollToTop />
    <script is:inline>
      document.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('scroll-progress');
        if (progressBar) progressBar.style.width = scrolled + '%';
      }, { passive: true });
    </script>
  </body>
</html>
