      </div>
      
      <div class="md:col-span-1">
        <ul class="space-y-3 text-sm text-text-muted font-light">
          <li><a href="#events" class="hover:text-text transition-colors">Events</a></li>
          <li><a href="#schedule" class="hover:text-text transition-colors">Schedule</a></li>
          <li><a href="#speakers" class="hover:text-text transition-colors">Speakers</a></li>
        </ul>
      </div>
      
      <div class="md:col-span-1">
        <ul class="space-y-3 text-sm text-text-muted font-light">
          <li><a href="#about" class="hover:text-text transition-colors">About Us</a></li>
          <li><a href="#faq" class="hover:text-text transition-colors">FAQ</a></li>
