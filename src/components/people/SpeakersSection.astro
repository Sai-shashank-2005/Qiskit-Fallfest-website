---
import { speakers } from '../../data/speakers';
---

<section id="speakers" class="py-24 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        EXPERTS
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Meet the Speakers</h2>
    </div>

    <div class="flex flex-wrap justify-center gap-8">
      {speakers.map((speaker, i) => (
        <div class="w-full max-w-sm bg-surface border border-border rounded-2xl overflow-hidden hover:border-[#ff4d80]/50 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-[#ff4d80]/10 group animate-fade-in-up" style={`animation-delay: ${i * 0.1}s;`}>
          <!-- Image Container -->
          <div class="aspect-square bg-border/30 relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center text-sm text-text-muted bg-bg">
              {speaker.image && speaker.image.includes('placeholder') ? (
                <span>Photo</span>
              ) : (
                <img src={speaker.image} alt={speaker.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="absolute inset-0 hidden items-center justify-center bg-bg text-text-muted font-medium">Photo: {speaker.name}</div>
              )}
            </div>
            <!-- Overlay gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-90"></div>
          </div>
          
          <div class="p-8 relative z-10 -mt-16">
            <div class="w-12 h-1 bg-[#ff4d80] mb-4 rounded-full group-hover:w-20 transition-all duration-300"></div>
            <h3 class="font-bold text-xl mb-1 text-text">{speaker.name}</h3>
            <p class="text-sm font-medium text-text-muted mb-1">{speaker.organization}</p>
            <p class="text-sm text-text-muted mb-6 font-light">{speaker.role}</p>
            
            <a href={speaker.linkedin || "#"} target={speaker.linkedin ? "_blank" : "_self"} rel={speaker.linkedin ? "noopener noreferrer" : ""} class="inline-flex items-center gap-2 text-text-muted hover:text-[#0077b5] transition-colors font-medium text-sm" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              Connect
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>
