---
// WhyFallFest component
---

<section id="about" class="py-24 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        ABOUT
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Why Fall Fest?</h2>
      <p class="text-text-muted max-w-2xl text-lg font-light">Join the global quantum community to learn, build, and collaborate.</p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6 relative z-10" id="cards-container">
      
      <!-- Learn Card -->
      <div class="glow-card group relative p-10 rounded-[2rem] bg-surface backdrop-blur-md border border-border/50 overflow-hidden min-h-[380px] flex flex-col justify-between hover:border-border hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#ff4d80]/10 transition-all duration-500">
        <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0" style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(255, 77, 128, 0.05), transparent 40%);"></div>
        
        <div class="relative z-10">
          <div class="w-14 h-14 mb-8 rounded-2xl bg-bg border border-border group-hover:border-[#ff4d80]/30 flex items-center justify-center text-text-muted group-hover:scale-110 group-hover:text-[#ff4d80] transition-all duration-500 shadow-sm">
            <img src="/event/materials/Sticker_01.svg" alt="Learn" class="w-10 h-10 object-contain" loading="lazy" decoding="async" />
          </div>
          <h3 class="text-3xl font-bold mb-4 text-text group-hover:text-[#ff4d80] transition-colors duration-300">Learn.</h3>
          <p class="text-text-muted text-sm leading-relaxed font-medium transition-colors">
            From the basics of quantum mechanics to real-world algorithms and applications.
          </p>
        </div>
        
        <!-- Animated visual (Restored) -->
        <div class="absolute -bottom-10 -left-10 w-56 h-56 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#b45bfa]/10 via-transparent to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none">
          <div class="absolute bottom-1/4 left-1/4 w-32 h-32 border border-[#b45bfa]/30 rounded-full animate-[spin_10s_linear_infinite] group-hover:border-[#b45bfa]/60 transition-colors">
            <div class="absolute -top-1 left-1/2 w-2 h-2 bg-[#b45bfa] rounded-full shadow-[0_0_8px_#b45bfa]"></div>
          </div>
          <div class="absolute bottom-1/3 left-1/3 w-16 h-16 border border-[#ff4d80]/30 rounded-full animate-[spin_6s_linear_infinite_reverse] group-hover:border-[#ff4d80]/60 transition-colors"></div>
        </div>
      </div>

      <!-- Build Card -->
      <div class="glow-card group relative p-10 rounded-[2rem] bg-surface backdrop-blur-md border border-border/50 overflow-hidden min-h-[380px] flex flex-col justify-between hover:border-border hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#b45bfa]/10 transition-all duration-500">
        <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0" style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(180, 91, 250, 0.05), transparent 40%);"></div>

        <div class="relative z-10">
          <div class="w-14 h-14 mb-8 rounded-2xl bg-bg border border-border group-hover:border-[#b45bfa]/30 flex items-center justify-center text-text-muted group-hover:scale-110 group-hover:text-[#b45bfa] transition-all duration-500 shadow-sm">
            <img src="/event/materials/Sticker_02.svg" alt="Build" class="w-10 h-10 object-contain" loading="lazy" decoding="async" />
          </div>
          <h3 class="text-3xl font-bold mb-4 text-text group-hover:text-[#b45bfa] transition-colors duration-300">Build.</h3>
          <p class="text-text-muted text-sm leading-relaxed font-medium transition-colors">
            Hands-on workshops and sessions using Qiskit on IBM Quantum hardware.
          </p>
        </div>
        
        <!-- Animated visual (Restored) -->
        <div class="absolute -bottom-6 right-0 w-64 h-64 flex items-end justify-end p-4 opacity-60 group-hover:opacity-100 transition-all duration-700 group-hover:scale-105 pointer-events-none">
          <div class="w-24 h-24 bg-gradient-to-br from-[#b45bfa]/10 to-[#b45bfa]/5 rounded-lg border border-border/60 backdrop-blur-sm shadow-[0_0_20px_rgba(180,91,250,0.15)] transform rotate-12 group-hover:rotate-6 transition-transform duration-500 animate-[pulse_4s_ease-in-out_infinite]"></div>
          <div class="w-16 h-16 bg-gradient-to-br from-[#ff4d80]/10 to-[#ff4d80]/5 rounded-lg border border-border/60 backdrop-blur-sm absolute bottom-12 right-20 shadow-[0_0_20px_rgba(255,77,128,0.15)] transform -rotate-12 group-hover:-rotate-6 transition-transform duration-500 animate-[pulse_3s_ease-in-out_infinite]" style="animation-delay: 1s;"></div>
        </div>
      </div>

      <!-- Collaborate Card -->
      <div class="glow-card group relative p-10 rounded-[2rem] bg-surface backdrop-blur-md border border-border/50 overflow-hidden min-h-[380px] flex flex-col justify-between hover:border-border hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#0077b5]/10 transition-all duration-500">
        <div class="glow-overlay absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none z-0" style="background: radial-gradient(600px circle at var(--mouse-x) var(--mouse-y), rgba(0, 119, 181, 0.05), transparent 40%);"></div>
        
        <div class="relative z-10">
          <div class="w-14 h-14 mb-8 rounded-2xl bg-bg border border-border group-hover:border-[#0077b5]/30 flex items-center justify-center text-text-muted group-hover:scale-110 group-hover:text-[#0077b5] transition-all duration-500 shadow-sm">
            <img src="/event/materials/Sticker_03.svg" alt="Collaborate" class="w-10 h-10 object-contain" loading="lazy" decoding="async" />
          </div>
          <h3 class="text-3xl font-bold mb-4 text-text group-hover:text-[#0077b5] transition-colors duration-300">Collaborate.</h3>
          <p class="text-text-muted text-sm leading-relaxed font-medium transition-colors">
            Connect, compete and create the future with the global quantum community.
          </p>
        </div>
        
        <!-- Animated visual (Restored) -->
        <div class="absolute bottom-0 right-0 w-full h-2/3 flex items-end justify-center p-4 overflow-hidden pointer-events-none">
           <div class="w-[150%] border-t border-[#0077b5]/30 absolute bottom-16 rotate-[-15deg] group-hover:rotate-[-10deg] transition-transform duration-700"></div>
           <div class="w-[150%] border-t border-border/80 absolute bottom-16 rotate-[15deg] group-hover:rotate-[10deg] transition-transform duration-700"></div>
           
           <div class="w-3 h-3 rounded-full bg-[#0077b5] absolute bottom-14 right-16 shadow-[0_0_15px_#0077b5] group-hover:scale-150 transition-transform duration-500"></div>
           <div class="w-2 h-2 rounded-full bg-text absolute bottom-20 left-1/4 group-hover:scale-150 transition-transform duration-500"></div>
           <div class="w-1.5 h-1.5 rounded-full bg-text absolute bottom-10 left-1/2 animate-pulse"></div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('cards-container');
    if (container && window.innerWidth > 768) {
      const cards = container.querySelectorAll('.glow-card');
      
      container.addEventListener('mousemove', (e) => {
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }
  });
</script>
