---
// RegistrationCTA component
---

<section class="py-32 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="group relative bg-surface border border-border rounded-3xl overflow-hidden shadow-xl flex flex-col md:flex-row items-center transition-all duration-700 hover:border-[#ff4d80]/30 hover:shadow-[#ff4d80]/10">
      
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#b45bfa]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000 -translate-x-full group-hover:translate-x-full ease-in-out"></div>

      <div class="p-12 md:p-20 relative z-10 w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 tracking-tight text-text leading-[1.1]">
          Ready to build the<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d80] to-[#b45bfa]">quantum future?</span>
        </h2>
        <p class="text-text-muted mb-10 text-lg font-light max-w-md leading-relaxed">
          Register now and be part of the next quantum computing revolution at Bharathidasan University.
        </p>
        
        <a href="/register" class="relative inline-flex items-center justify-center gap-3 px-10 py-4 bg-gradient-to-r from-[#ff4d80] to-[#ff7597] text-white text-base font-semibold rounded-full overflow-hidden transition-all hover:scale-105 shadow-[0_0_30px_rgba(255,77,128,0.4)] w-max cursor-pointer mx-auto md:mx-0">
          <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out rounded-full"></span>
          <span class="relative z-10 flex items-center gap-2">Register Now <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </a>
      </div>

      <div class="relative h-[400px] md:h-[500px] w-full md:w-1/2 flex items-center justify-center overflow-hidden perspective-[1000px] z-0 rounded-b-3xl md:rounded-r-3xl md:rounded-bl-none">
        
        <div id="cta-interactive-grid" class="absolute inset-0 flex items-center justify-center transition-transform duration-300 ease-out preserve-3d rotate-y-[-10deg]">
          
          <div class="relative w-72 h-72 transform rotate-x-45 rotate-z-45 opacity-60">
             <div class="absolute inset-0 border border-[#b45bfa]/20 rounded-full animate-[spin_10s_linear_infinite] group-hover:border-[#b45bfa]/40 transition-colors duration-700"></div>
             <div class="absolute inset-0 border border-[#ff4d80]/20 rounded-full animate-[spin_7s_linear_infinite_reverse] scale-75 group-hover:border-[#ff4d80]/40 transition-colors duration-700"></div>
             <div class="absolute inset-0 border border-border/50 rounded-full animate-[spin_5s_linear_infinite] scale-50 group-hover:border-border transition-colors duration-700"></div>
             
             <div class="grid grid-cols-4 gap-2 absolute inset-0 transform translate-z-[40px]">
               {[...Array(16)].map((_, i) => (
                 <div class="w-full h-full bg-[#ff4d80]/10 backdrop-blur-md rounded-full border border-[#ff4d80]/20 scale-0 group-hover:scale-100 transition-all duration-700 ease-out" style={`transition-delay: ${i * 50}ms; box-shadow: 0 0 10px rgba(255,77,128,0.2)`}></div>
               ))}
             </div>
          </div>
          
        </div>
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 drop-shadow-[0_0_40px_rgba(180,91,250,0.5)] group-hover:-translate-y-[55%] transition-transform duration-700 ease-out pointer-events-none">
           <img 
             src="/event/materials/badge-pink.svg" 
             alt="Qiskit Badge" 
             class="w-40 h-40 md:w-56 md:h-56 object-contain animate-float"
             loading="lazy" decoding="async"
             onerror="this.style.display='none'"
           />
        </div>

        <div class="absolute inset-0 z-30 pointer-events-none">
          <img 
            src="/brand/qiskit/bird1.png" 
            alt="Fall Fest Bird 1" 
            class="absolute top-8 right-6 md:top-12 md:right-12 w-24 h-24 sm:w-36 sm:h-36 object-contain animate-float drop-shadow-[0_15px_25px_rgba(255,77,128,0.3)] transform rotate-12"
            style="animation-delay: 0.5s;"
            loading="lazy" decoding="async"
          />
          <img 
            src="/brand/qiskit/bird2.png" 
            alt="Fall Fest Bird 2" 
            class="absolute bottom-10 left-6 md:bottom-16 md:left-12 w-20 h-20 sm:w-28 sm:h-28 object-contain animate-float-reverse drop-shadow-[0_15px_25px_rgba(180,91,250,0.3)] transform -rotate-12"
            loading="lazy" decoding="async"
          />
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .preserve-3d {
    transform-style: preserve-3d;
  }
  .rotate-y-\[-10deg\] {
    transform: rotateY(-10deg);
  }
  .rotate-x-45 {
    transform: rotateX(60deg);
  }
  .rotate-z-45 {
    transform: rotateX(60deg) rotateZ(45deg);
  }
  .translate-z-\[40px\] {
    transform: translateZ(40px);
  }

  /* Custom Float Animations for smoother looping */
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(12deg); }
    50% { transform: translateY(-20px) rotate(15deg); }
  }
  @keyframes float-reverse {
    0%, 100% { transform: translateY(0) rotate(-12deg); }
    50% { transform: translateY(20px) rotate(-15deg); }
  }
  
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  .animate-float-reverse {
    animation: float-reverse 7s ease-in-out infinite;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('cta-interactive-grid');
    
    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (grid && window.innerWidth > 768 && !prefersReducedMotion) {
      let rafId = null;
      
      document.addEventListener('mousemove', (e) => {
        if (rafId) cancelAnimationFrame(rafId);
        
        rafId = requestAnimationFrame(() => {
          const x = (e.clientX / window.innerWidth - 0.5) * 15; // Softened the rotation
          const y = (e.clientY / window.innerHeight - 0.5) * 15;
          grid.style.transform = `rotateY(${-10 + x}deg) rotateX(${-y}deg)`;
        });
      });
    }
  });
</script>