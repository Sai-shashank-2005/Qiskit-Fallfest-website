---
// AboutSection component
---

<section class="py-32 relative overflow-hidden bg-bg">
  <div class="container mx-auto px-6 max-w-5xl relative z-10">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      
      <!-- Text Content -->
      <div class="space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-full border border-border bg-surface text-[10px] uppercase tracking-[0.2em] font-semibold text-text-muted shadow-sm">
            The Experience
          </div>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-text mb-6">
            About the Event
          </h2>
        </div>
        
        <div class="space-y-6 text-text-muted leading-relaxed font-light text-lg">
          <p>
            <span class="text-text font-medium">Qiskit Fall Fest</span> is a collection of quantum computing events on college campuses around the world.
          </p>
          <p>
            At Bharathidasan University, we are uniting students, researchers, and developers to learn the fundamentals of quantum computation and experiment directly with IBM Quantum hardware via the cloud.
          </p>
          <p class="text-[#ff4d80]/80 italic font-medium">
            Whether you are a physics major or a computer science student, the quantum future needs builders from every discipline.
          </p>
        </div>
      </div>
      
      <!-- Stats / Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 gap-6 relative w-full mt-10 md:mt-0">
        <div class="group relative bg-surface border border-border/50 p-8 rounded-3xl transition-all duration-500 overflow-hidden shadow-sm hover:shadow-2xl hover:border-border hover:-translate-y-1 flex flex-col justify-between">
          <div class="absolute inset-0 bg-gradient-to-br from-[#ff4d80]/0 to-[#ff4d80]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 flex items-start justify-between mb-4">
            <div class="text-5xl lg:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[#ff4d80] to-[#b45bfa] group-hover:scale-105 origin-left transition-transform duration-500">2</div>
            <div class="w-12 h-12 rounded-full flex items-center justify-center group-hover:rotate-12 transition-transform duration-500 shrink-0 bg-bg/50 border border-border/50">
              <img src="/event/materials/Sticker_Theme_Magenta.svg" alt="Days Icon" class="w-8 h-8 object-contain drop-shadow-md" />
            </div>
          </div>
          <div class="relative z-10">
            <p class="text-sm font-bold text-text uppercase tracking-wider mb-2">Action-Packed Days</p>
            <p class="text-text-muted text-sm font-light leading-relaxed">Immersive deep learning, workshops, and intensive hackathon challenges.</p>
          </div>
        </div>
        
        <div class="group relative bg-surface border border-border/50 p-8 rounded-3xl transition-all duration-500 overflow-hidden shadow-sm hover:shadow-2xl hover:border-border hover:-translate-y-1 flex flex-col justify-between">
          <div class="absolute inset-0 bg-gradient-to-br from-[#b45bfa]/0 to-[#b45bfa]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 flex items-start justify-between mb-4">
            <div class="text-5xl lg:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[#b45bfa] to-[#ff4d80] group-hover:scale-105 origin-left transition-transform duration-500">100+</div>
            <div class="w-12 h-12 rounded-full flex items-center justify-center group-hover:-rotate-12 transition-transform duration-500 shrink-0 bg-bg/50 border border-border/50">
              <img src="/event/materials/Sticker_Pictogram-Purple.svg" alt="Participants Icon" class="w-8 h-8 object-contain drop-shadow-md" />
            </div>
          </div>
          <div class="relative z-10">
            <p class="text-sm font-bold text-text uppercase tracking-wider mb-2">Expected Participants</p>
            <p class="text-text-muted text-sm font-light leading-relaxed">Join brilliant minds across disciplines to build the quantum future.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
