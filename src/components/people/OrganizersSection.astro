---
import { organizers } from '../../data/organizers';
---

<section id="organizers" class="py-24 relative overflow-hidden bg-surface/30">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="mb-16 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full border border-border bg-surface text-[10px] uppercase tracking-widest font-semibold text-text-muted">
        TEAM
      </div>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Meet the Organizers</h2>
      <p class="text-text-muted max-w-2xl text-lg font-light">The dedicated individuals bringing the Fall Fest to life.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {organizers.map((organizer) => (
        <div class="flex items-center p-6 bg-surface border border-border rounded-2xl gap-6 group hover:border-[#b45bfa]/50 hover:shadow-lg hover:shadow-[#b45bfa]/10 transition-all cursor-pointer">
          <div class="w-16 h-16 rounded-full bg-bg border-2 border-transparent group-hover:border-[#b45bfa]/50 transition-colors flex items-center justify-center shrink-0 overflow-hidden relative shadow-inner text-[#b45bfa]/70 group-hover:text-[#b45bfa]">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          
          <div class="flex-grow">
            <h3 class="font-bold text-base text-text mb-1 group-hover:text-[#b45bfa] transition-colors">{organizer.name}</h3>
            <p class="text-xs font-medium text-text-muted uppercase tracking-wider">{organizer.role}</p>
          </div>
          
          <div class="text-text-muted group-hover:text-[#0077b5] transition-colors shrink-0">
             <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
