---
// EventDetailsCard component
---

<div class="relative p-1 rounded-2xl bg-gradient-to-br from-quantum/20 to-transparent overflow-hidden h-full">
  <div class="absolute inset-0 bg-surface opacity-90"></div>
  
  <div class="relative p-8 h-full z-10">
    <h3 class="text-2xl font-semibold mb-6">What to Expect</h3>
    
    <ul class="space-y-6">
      <li class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-full bg-quantum/10 flex items-center justify-center shrink-0 mt-1">
          <span class="w-2 h-2 rounded-full bg-quantum"></span>
        </div>
        <div>
          <h4 class="font-medium text-lg">Hands-on Quantum</h4>
          <p class="text-text-muted text-sm mt-1">Practical exploration of Qiskit and quantum circuits.</p>
        </div>
      </li>
      
      <li class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center shrink-0 mt-1">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
        </div>
        <div>
          <h4 class="font-medium text-lg">Expert Talks</h4>
          <p class="text-text-muted text-sm mt-1">Learn from industry leaders and quantum researchers.</p>
        </div>
      </li>
      
      <li class="flex items-start gap-4">
        <div class="w-8 h-8 rounded-full bg-lavender/10 flex items-center justify-center shrink-0 mt-1">
          <span class="w-2 h-2 rounded-full bg-lavender"></span>
        </div>
        <div>
          <h4 class="font-medium text-lg">Collaboration</h4>
          <p class="text-text-muted text-sm mt-1">Network with peers and build solutions together.</p>
        </div>
      </li>
    </ul>
  </div>
</div>
